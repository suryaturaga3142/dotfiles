{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "mcp__claude_ai__*"
    ],
    "deny": [
      "Bash",

      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",

      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",

      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",

      "Read(**/.git/**)",
      "Edit(**/.git/**)",

      "Read(**/node_modules/**)",
      "Edit(**/node_modules/**)",

      "Read(**/.venv/**)",
      "Edit(**/.venv/**)",

      "Read(**/venv/**)",
      "Edit(**/venv/**)",

      "Read(**/__pycache__/**)",
      "Edit(**/__pycache__/**)",

      "Read(**/*-lock.json)",
      "Edit(**/*-lock.json)",

      "Read(**/package-lock.json)",
      "Edit(**/package-lock.json)",

      "Read(**/yarn.lock)",
      "Edit(**/yarn.lock)",

      "Read(**/pnpm-lock.yaml)",
      "Edit(**/pnpm-lock.yaml)",

      "Read(**/Cargo.lock)",
      "Edit(**/Cargo.lock)",

      "Read(**/poetry.lock)",
      "Edit(**/poetry.lock)",

      "Read(**/gemfile.lock)",
      "Edit(**/gemfile.lock)",

      "Read(**/flake.lock)",
      "Edit(**/flake.lock)",

      "Read(**/*.swp)",
      "Edit(**/*.swp)",

      "Read(**/*.swo)",
      "Edit(**/*.swo)",

      "Read(**/*~)",
      "Edit(**/*~)",

      "Read(**/*.min.js)",
      "Edit(**/*.min.js)",

      "Read(**/*.min.css)",
      "Edit(**/*.min.css)",

      "Read(**/*.map)",
      "Edit(**/*.map)",

      "Read(**/*.sqlite)",
      "Edit(**/*.sqlite)",

      "Read(**/*.db)",
      "Edit(**/*.db)"

    ],
    "ask": [
      "Edit",
      "Write"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "model": "sonnet",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.npmjs.org",
        "registry.npmjs.org",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "api.anthropic.com",
        "*.anthropic.com",
        "*.googleapis.com",
        "*.google.com",
        "accounts.google.com",
        "oauth2.googleapis.com",
        "ghcr.io"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.gnupg/**"
      ]
    }
  },
  "effortLevel": "xhigh",
  "theme": "auto"
}
