{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "mcp__claude_ai__*",
      "WebFetch(domain:docs.zephyrproject.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rust-embedded.org)",
      "WebFetch(domain:embassy.dev)",
      "WebFetch(domain:docs.embassy.dev)",
      "WebFetch(domain:probe.rs)",
      "WebFetch(domain:en.cppreference.com)",
      "WebFetch(domain:www.gem5.org)",
      "WebFetch(domain:gem5.googlesource.com)",
      "WebFetch(domain:www.raspberrypi.com)",
      "WebFetch(domain:datasheets.raspberrypi.com)",
      "WebFetch(domain:developer.arm.com)",
      "WebFetch(domain:man7.org)",
      "WebFetch(domain:gcc.gnu.org)",
      "WebFetch(domain:sourceware.org)",
      "WebFetch(domain:llvm.org)",
      "WebFetch(domain:cmake.org)",
      "WebFetch(domain:docs.kernel.org)",
      "WebFetch(domain:devicetree-specification.readthedocs.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:*.stackoverflow.com)",
      "WebFetch(domain:*.stackexchange.com)",
      "WebFetch(domain:*.superuser.com)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(rm -rf *)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.config/gh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.git/**)",
      "Edit(**/.git/**)",
      "Read(**/node_modules/**)",
      "Edit(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Edit(**/.venv/**)",
      "Read(**/venv/**)",
      "Edit(**/venv/**)",
      "Read(**/__pycache__/**)",
      "Edit(**/__pycache__/**)",
      "Edit(**/*-lock.json)",
      "Edit(**/package-lock.json)",
      "Edit(**/yarn.lock)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/Cargo.lock)",
      "Edit(**/poetry.lock)",
      "Edit(**/Gemfile.lock)",
      "Edit(**/flake.lock)",
      "Edit(**/*.min.js)",
      "Edit(**/*.min.css)",
      "Edit(**/*.sqlite)",
      "Edit(**/*.db)",
      "Edit(**/*.swp)",
      "Edit(**/*~)",
      "Edit(.claude/**)"
    ],
    "ask": [
      "Bash",
      "Edit",
      "Write"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "model": "sonnet",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "crates.io",
        "*.crates.io",
        "static.rust-lang.org",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "*.npmjs.org",
        "gem5.googlesource.com",
        "api.anthropic.com",
        "*.anthropic.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.gnupg/**",
        "~/.netrc",
        "~/.config/gh/**"
      ]
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "auto"
}
