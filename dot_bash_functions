# Setup tmux workspace
mytmux () {
    local session="work"
    local tab0="def"
    local mtabs=("alt" "mon" "syn")
    if [ -n "$TMUX" ]; then
        echo "Already in a tmux session. Detach and try again."
        return 1
    fi
    if tmux has-session -t $session 2>/dev/null; then
        tmux attach -t $session
        return 0
    fi
    tmux new-session -d -s $session -n $tab0
    for tab_name in ${mtabs[@]}; do
        tmux new-window -t $session -n $tab_name
    done
    tmux attach -t "$session:$tab0"
}

# Conda manager
cm () {
    # Check if conda is installed and available in PATH
    if ! command -v conda >/dev/null 2>&1; then
        echo -e "${RED}Error:${NC} conda command not found. Please install Miniconda first."
        return 1
    fi

    # Fetch available conda environments
    local get_conda_list=($(conda env list | awk '/^[a-zA-Z0-9_-]/ {print $1}'))

    show_usage() {
        echo -e "${B_PURPLE}Conda Env Manager${NC}"
        echo -e "Usage: cm ${YELLOW}<name>${NC} [flags]"
        echo ""
        echo -e "Commands:"
        echo -e "  ${YELLOW}<name>${NC}         Activate an existing conda env (e.g., 'cm work')."
        echo -e "  ${YELLOW}<name>${NC} ${CYAN}--create${NC} Create and activate a new conda env."
        echo -e "  ${CYAN}list${NC}           List all available conda envs."
        echo -e "  ${CYAN}--kill${NC}         Deactivate the current session."
        echo -e "  ${CYAN}--help${NC}         Show this help message."
        echo ""
        
        if [ ${#get_conda_list[@]} -eq 0 ]; then
            echo -e "Detected Envs: ${RED}None${NC}"
        else
            echo -e "Detected Envs: ${YELLOW}${get_conda_list[*]}${NC}"
        fi
    }

    if [[ -z "$1" || "$1" == "--help" || "$1" == "-h" ]]; then
        show_usage
        unset -f show_usage
        return 0
    fi

    local MODE="$1"
    local FLAG="$2"

    case "$MODE" in
        list)
            echo -e "${B_PURPLE}Available Conda Environments:${NC}"
            if [ ${#get_conda_list[@]} -eq 0 ]; then
                echo "  (None)"
            else
                for c in "${get_conda_list[@]}"; do
                    # Add a little star if it's the currently active env
                    if [[ "$CONDA_DEFAULT_ENV" == "$c" ]]; then
                        echo -e "  - ${GREEN}$c${NC} (active)"
                    else
                        echo "  - $c"
                    fi
                done
            fi
            ;;

        --kill)
            # CONDA_DEFAULT_ENV is a built-in variable conda uses to track the active env
            if [[ -n "$CONDA_DEFAULT_ENV" && "$CONDA_DEFAULT_ENV" != "base" ]]; then
                conda deactivate
                echo -e "${GREEN}Success:${NC} Conda environment deactivated."
            elif [[ "$CONDA_DEFAULT_ENV" == "base" ]]; then
                conda deactivate
                echo -e "${YELLOW}Warning:${NC} Deactivated base environment."
            else
                echo -e "${RED}Error:${NC} No conda environment is currently active."
                return 1
            fi
            ;;

        *)
            local ENV_NAME="$MODE"
            local env_exists=false

            # Check if requested env is in fetched list
            for e in "${get_conda_list[@]}"; do
                if [[ "$e" == "$ENV_NAME" ]]; then
                    env_exists=true
                    break
                fi
            done
            
            if [ "$FLAG" == "--create" ]; then
                if [ "$env_exists" = true ]; then
                    echo -e "${YELLOW}Warning:${NC} '$ENV_NAME' already exists. Activating..."
                else
                    echo -e "Creating new conda env: ${CYAN}$ENV_NAME${NC}..."
                    # Automatically installs default python to mimic standard venv behavior
                    conda create -y -n "$ENV_NAME" python
                    
                    if [ $? -eq 0 ]; then
                        echo -e "${GREEN}Success:${NC} Conda env created."
                    else
                        echo -e "${RED}Error:${NC} Conda creation failed."
                        return 1
                    fi
                fi
            elif [ "$env_exists" = false ]; then
                echo -e "${RED}Error:${NC} Conda env '${YELLOW}$ENV_NAME${NC}' does not exist."
                echo -e "To create it, run: ${CYAN}cm $MODE --create${NC}"
                return 1
            fi

            echo -e "Activating ${CYAN}$ENV_NAME${NC}..."
            # Conda shell functions must be initialized in bashrc for this to work natively
            conda activate "$ENV_NAME"
            ;;
    esac

    unset -f show_usage
}

# Manage python venvs with uv
vm () {
    local VENV_ROOT_DIR="$HOME/venvs"

    get_venv_list=()
    if [ -d "$VENV_ROOT_DIR" ]; then
        for dir in "$VENV_ROOT_DIR"/venv-*/; do
            [ -d "$dir" ] || continue
            local base=$(basename "$dir")
            get_venv_list+=("${base#venv-}")
        done
    fi

    show_usage() {
        echo -e "${B_PURPLE}Python Venv Manager${NC}"
        echo -e "Usage: vm ${YELLOW}<name>${NC} [flags] [python_version]"
        echo ""
        echo -e "Commands:"
        echo -e "  ${YELLOW}<name>${NC}                 Activate an existing venv."
        echo -e "  ${YELLOW}<name>${NC} ${CYAN}--create${NC}        Create a venv (defaults to latest system Python)."
        echo -e "  ${YELLOW}<name>${NC} ${CYAN}--create 3.9${NC}    Create a venv with a specific Python version."
        echo -e "  ${CYAN}list${NC}                   List all available venvs."
        echo -e "  ${CYAN}--kill${NC}                 Deactivate the current session."
        echo -e "  ${CYAN}--help${NC}                 Show this help message."
        echo ""
        
        if [ ${#get_venv_list[@]} -eq 0 ]; then
            echo -e "Detected Venvs: ${RED}None${NC}"
        else
            echo -e "Detected Venvs: ${YELLOW}${get_venv_list[*]}${NC}"
        fi
    }

    if [[ -z "$1" || "$1" == "--help" || "$1" == "-h" ]]; then
        show_usage
        return 0
    fi

    local MODE="$1"
    local FLAG="$2"
    local PY_VER="$3"

    if [ ! -d "$VENV_ROOT_DIR" ]; then
        echo -e "${CYAN}Initializing Venv Root at ${YELLOW}$VENV_ROOT_DIR${NC}..."
        mkdir -p "$VENV_ROOT_DIR"
    fi

    case "$MODE" in
        list)
            echo -e "${B_PURPLE}Available Virtual Environments:${NC}"
            if [ ${#get_venv_list[@]} -eq 0 ]; then
                echo "  (None)"
            else
                for v in "${get_venv_list[@]}"; do
                    echo "  - $v"
                done
            fi
            ;;

        --kill)
            if type deactivate >/dev/null 2>&1; then
                deactivate
                echo -e "${GREEN}Success:${NC} Environment deactivated."
            else
                echo -e "${RED}Error:${NC} No virtual environment is currently active."
                return 1
            fi
            ;;

        *)
            local ENV_NAME="venv-$MODE"
            local TARGET_DIR="$VENV_ROOT_DIR/$ENV_NAME"
            
            if [ "$FLAG" == "--create" ]; then
                if [ -d "$TARGET_DIR" ]; then
                    echo -e "${YELLOW}Warning:${NC} '$ENV_NAME' already exists. Activating..."
                else
                    echo -e "Creating new venv: ${CYAN}$ENV_NAME${NC}..."
                    
                    # uv handles the creation and version routing
                    if [ -n "$PY_VER" ]; then
                        uv venv --python "$PY_VER" "$TARGET_DIR"
                    else
                        uv venv "$TARGET_DIR"
                    fi
                    
                    if [ $? -eq 0 ]; then
                        echo -e "${GREEN}Success:${NC} Venv created via uv."
                    else
                        echo -e "${RED}Error:${NC} uv venv creation failed."
                        return 1
                    fi
                fi
            elif [ ! -d "$TARGET_DIR" ]; then
                echo -e "${RED}Error:${NC} Venv '${YELLOW}$ENV_NAME${NC}' does not exist."
                echo -e "To create it, run: ${CYAN}vm $MODE --create [version]${NC}"
                return 1
            fi

            local ACTIVATE_SCRIPT="$TARGET_DIR/bin/activate"
            if [ -f "$ACTIVATE_SCRIPT" ]; then
                echo -e "Activating ${CYAN}$ENV_NAME${NC}..."
                source "$ACTIVATE_SCRIPT"
            else
                echo -e "${RED}Error:${NC} Venv folder exists, but cannot find activation script."
                return 1
            fi
            ;;
    esac

    unset -f get_venv_list
    unset -f show_usage
}


# Manage Zephyr workspaces and SDKs (selects ZEPHYR_BASE + ZEPHYR_SDK_INSTALL_DIR)
# Layout:  ~/zephyr/v<ver>/            west workspaces
#          ~/zephyr/.cache/            shared git cache for west update
#          ~/sdk/zephyr-sdk-<sdkver>/  Zephyr SDKs
# Needs ${B_PURPLE} ${YELLOW} ${CYAN} ${RED} ${GREEN} ${NC} to be defined, same as vm().
zephyr () {
    # Wrapper so helpers and temp lists are always cleaned up, even on early returns
    _zephyr_impl "$@"
    local rc=$?
    unset -f recommended_sdk sdk_toolchains need_west show_usage
    unset get_zephyr_list get_sdk_list
    return $rc
}

_zephyr_impl () {
    local ZEPHYR_DIR="$HOME/zephyr"
    local SDK_DIR="$HOME/zephyr/sdk"
    local CACHE_DIR="$ZEPHYR_DIR/.cache"
    local ZEPHYR_URL="https://github.com/zephyrproject-rtos/zephyr"
    local DEFAULT_TOOLCHAINS=("arm-zephyr-eabi")

    # Zephyr versions that have a workspace folder
    get_zephyr_list=()
    if [ -d "$ZEPHYR_DIR" ]; then
        for dir in "$ZEPHYR_DIR"/v*/; do
            [ -d "$dir" ] || continue
            local base=$(basename "$dir")
            get_zephyr_list+=("${base#v}")
        done
    fi

    # SDK versions that are installed
    get_sdk_list=()
    if [ -d "$SDK_DIR" ]; then
        for dir in "$SDK_DIR"/zephyr-sdk-*/; do
            [ -d "$dir" ] || continue
            local base=$(basename "$dir")
            get_sdk_list+=("${base#zephyr-sdk-}")
        done
    fi

    # Echo the SDK version a workspace recommends (empty if unknown)
    recommended_sdk() {
        local f="$ZEPHYR_DIR/v$1/zephyr/SDK_VERSION"
        [ -f "$f" ] && tr -d '[:space:]' < "$f"
    }

    # Echo the toolchains found inside an installed SDK
    sdk_toolchains() {
        local sdk="$SDK_DIR/zephyr-sdk-$1"
        local t found=()
        for t in "$sdk"/gnu/*/; do
            [ -d "$t" ] && found+=("$(basename "$t")")
        done
        [ -d "$sdk/llvm" ] && found+=("llvm")
        echo "${found[*]}"
    }

    need_west() {
        if [ -z "$VIRTUAL_ENV" ] || ! command -v west >/dev/null 2>&1; then
            echo -e "${RED}Error:${NC} No active venv with ${YELLOW}west${NC}. Activate your venv first."
            return 1
        fi
    }

    show_usage() {
        echo -e "${B_PURPLE}Zephyr Manager${NC}"
        echo -e "Usage: zephyr ${CYAN}-v${NC} ${YELLOW}<version>${NC} [flags]"
        echo ""
        echo -e "Commands:"
        echo -e "  ${CYAN}-v${NC} ${YELLOW}4.5.0${NC}                   Activate Zephyr 4.5.0 and its recommended SDK."
        echo -e "  ${CYAN}-v${NC} ${YELLOW}4.5.0${NC} ${CYAN}--init${NC}            Create a workspace (west init) for that version."
        echo -e "  ${CYAN}-v${NC} ${YELLOW}4.5.0${NC} ${CYAN}--update${NC}          Run west update (shared cache) in that workspace."
        echo -e "  ${CYAN}-v${NC} ${YELLOW}4.5.0${NC} ${CYAN}--get-sdk${NC} [tc..]  Install the recommended SDK (default: ${DEFAULT_TOOLCHAINS[*]})."
        echo -e "  ${CYAN}list${NC}                       List Zephyr versions and their recommended SDK."
        echo -e "  ${CYAN}--kill${NC}                     Deactivate the current Zephyr/SDK selection."
        echo -e "  ${CYAN}--help${NC}                     Show this help message."
        echo ""

        if [ ${#get_zephyr_list[@]} -eq 0 ]; then
            echo -e "Detected Zephyrs: ${RED}None${NC}"
        else
            echo -e "Detected Zephyrs: ${YELLOW}${get_zephyr_list[*]}${NC}"
        fi

        if [ ${#get_sdk_list[@]} -eq 0 ]; then
            echo -e "Detected SDKs:    ${RED}None${NC}"
        else
            echo -e "Detected SDKs:"
            local s
            for s in "${get_sdk_list[@]}"; do
                local tcs=$(sdk_toolchains "$s")
                echo -e "  ${YELLOW}$s${NC} (toolchains: ${CYAN}${tcs:-none}${NC})"
            done
        fi
    }

    if [[ $# -eq 0 ]]; then
        show_usage
        return 0
    fi

    # Parse arguments
    local ACTION="activate"
    local VER=""
    local EXTRA=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) ACTION="help" ;;
            list)      ACTION="list" ;;
            --kill)    ACTION="kill" ;;
            --init)    ACTION="init" ;;
            --update)  ACTION="update" ;;
            --get-sdk) ACTION="get-sdk" ;;
            -v)
                shift
                VER="${1#v}"
                if [ -z "$VER" ]; then
                    echo -e "${RED}Error:${NC} ${CYAN}-v${NC} needs a version, e.g. ${CYAN}zephyr -v 4.5.0${NC}"
                    return 1
                fi
                ;;
            *) EXTRA+=("$1") ;;
        esac
        shift
    done

    if [[ ! "$VER" =~ ^[A-Za-z0-9._-]*$ ]]; then
        echo -e "${RED}Error:${NC} Invalid version '${YELLOW}$VER${NC}'."
        return 1
    fi

    local WS="$ZEPHYR_DIR/v$VER"

    case "$ACTION" in
        help)
            show_usage
            ;;

        list)
            echo -e "${B_PURPLE}Available Zephyr Versions:${NC}"
            if [ ${#get_zephyr_list[@]} -eq 0 ]; then
                echo "  (None)"
            else
                local z
                for z in "${get_zephyr_list[@]}"; do
                    local sdkver=$(recommended_sdk "$z")
                    if [ -z "$sdkver" ]; then
                        echo -e "  v$z -> ${RED}unknown${NC} (run: ${CYAN}zephyr -v $z --update${NC})"
                    elif [ -d "$SDK_DIR/zephyr-sdk-$sdkver" ]; then
                        echo -e "  v$z -> ${YELLOW}v$sdkver${NC} ${GREEN}(installed)${NC}"
                    else
                        echo -e "  v$z -> ${YELLOW}v$sdkver${NC} ${RED}(missing)${NC}"
                    fi
                done
            fi
            echo ""
            echo -e "${B_PURPLE}Installed SDKs:${NC}"
            if [ ${#get_sdk_list[@]} -eq 0 ]; then
                echo "  (None)"
            else
                local s
                for s in "${get_sdk_list[@]}"; do
                    echo -e "  - v$s"
                done
            fi
            ;;

        kill)
            if [ -n "$ZEPHYR_BASE" ] || [ -n "$ZEPHYR_SDK_INSTALL_DIR" ]; then
                unset ZEPHYR_BASE ZEPHYR_SDK_INSTALL_DIR ZEPHYR_ACTIVE_VERSION
                echo -e "${GREEN}Success:${NC} Zephyr environment deactivated."
            else
                echo -e "${RED}Error:${NC} No Zephyr environment is currently active."
                return 1
            fi
            ;;

        init)
            if [ -z "$VER" ]; then
                echo -e "${RED}Error:${NC} Usage: ${CYAN}zephyr -v <version> --init${NC}"
                return 1
            fi
            need_west || return 1
            if [ -d "$WS" ]; then
                echo -e "${YELLOW}Warning:${NC} v$VER already exists at ${YELLOW}$WS${NC}. Skipping."
                return 0
            fi
            mkdir -p "$ZEPHYR_DIR"
            echo -e "Initializing workspace: ${CYAN}v$VER${NC}..."
            if west init -m "$ZEPHYR_URL" --mr "v$VER" "$WS"; then
                echo -e "${GREEN}Success:${NC} Workspace created at ${YELLOW}$WS${NC}."
                echo ""
                echo -e "Next, run either:"
                echo -e "  ${CYAN}zephyr -v $VER --update${NC}"
                echo -e "  ${CYAN}cd $WS && west update --narrow --fetch-opt=--filter=tree:0 --auto-cache $CACHE_DIR${NC}"
            else
                echo -e "${RED}Error:${NC} west init failed."
                return 1
            fi
            ;;

        update)
            if [ -z "$VER" ]; then
                echo -e "${RED}Error:${NC} Usage: ${CYAN}zephyr -v <version> --update${NC}"
                return 1
            fi
            need_west || return 1
            if [ ! -d "$WS/.west" ]; then
                echo -e "${RED}Error:${NC} Zephyr '${YELLOW}v$VER${NC}' is not initialized."
                echo -e "To create it, run: ${CYAN}zephyr -v $VER --init${NC}"
                return 1
            fi
            mkdir -p "$CACHE_DIR"
            echo -e "Updating ${CYAN}v$VER${NC}..."
            if ( cd "$WS" && west update --narrow --fetch-opt=--filter=tree:0 --auto-cache "$CACHE_DIR" ); then
                echo -e "${GREEN}Success:${NC} v$VER updated."
                echo -e "Recommended SDK: ${YELLOW}v$(recommended_sdk "$VER")${NC}"
                echo -e "Python deps (into your active venv): ${CYAN}pip install -r $WS/zephyr/scripts/requirements.txt${NC}"
            else
                echo -e "${RED}Error:${NC} west update failed."
                return 1
            fi
            ;;

        get-sdk)
            if [ -z "$VER" ]; then
                echo -e "${RED}Error:${NC} Usage: ${CYAN}zephyr -v <version> --get-sdk [toolchain...]${NC}"
                return 1
            fi
            need_west || return 1
            if [ ! -d "$WS" ]; then
                echo -e "${RED}Error:${NC} Zephyr '${YELLOW}v$VER${NC}' does not exist."
                echo -e "To create it, run: ${CYAN}zephyr -v $VER --init${NC}"
                return 1
            fi
            local sdkver=$(recommended_sdk "$VER")
            if [ -z "$sdkver" ]; then
                echo -e "${RED}Error:${NC} Cannot read ${YELLOW}zephyr/SDK_VERSION${NC} for v$VER."
                echo -e "Run ${CYAN}zephyr -v $VER --update${NC} first."
                return 1
            fi
            if [ -d "$SDK_DIR/zephyr-sdk-$sdkver" ]; then
                echo -e "${YELLOW}Warning:${NC} SDK v$sdkver already exists at ${YELLOW}$SDK_DIR/zephyr-sdk-$sdkver${NC}. Skipping."
                return 0
            fi
            local tcs=("${EXTRA[@]}")
            [ ${#tcs[@]} -eq 0 ] && tcs=("${DEFAULT_TOOLCHAINS[@]}")
            mkdir -p "$SDK_DIR"
            echo -e "Installing SDK ${CYAN}v$sdkver${NC} (${tcs[*]}) into ${YELLOW}$SDK_DIR${NC}..."
            # west sdk only exists inside a workspace, so run it from there
            if ( cd "$WS" && ZEPHYR_BASE="$WS/zephyr" west sdk install --version "$sdkver" --install-base "$SDK_DIR" -t "${tcs[@]}" ); then
                echo -e "${GREEN}Success:${NC} SDK v$sdkver installed."
            else
                echo -e "${RED}Error:${NC} west sdk install failed."
                return 1
            fi
            ;;

        activate)
            if [ -z "$VER" ]; then
                echo -e "${RED}Error:${NC} Usage: ${CYAN}zephyr -v <version>${NC}"
                return 1
            fi
            need_west || return 1
            if [ ! -d "$WS/zephyr" ]; then
                echo -e "${RED}Error:${NC} Zephyr '${YELLOW}v$VER${NC}' does not exist (or is not updated yet)."
                echo -e "To create it, run: ${CYAN}zephyr -v $VER --init${NC}"
                return 1
            fi
            local sdkver=$(recommended_sdk "$VER")
            if [ -z "$sdkver" ]; then
                echo -e "${RED}Error:${NC} Cannot read ${YELLOW}zephyr/SDK_VERSION${NC} for v$VER."
                return 1
            fi
            local sdkpath="$SDK_DIR/zephyr-sdk-$sdkver"
            if [ ! -d "$sdkpath" ]; then
                echo -e "${RED}Error:${NC} Recommended SDK '${YELLOW}v$sdkver${NC}' is not installed."
                echo -e "To install it, run: ${CYAN}zephyr -v $VER --get-sdk${NC}"
                return 1
            fi
            export ZEPHYR_BASE="$WS/zephyr"
            export ZEPHYR_SDK_INSTALL_DIR="$sdkpath"
            export ZEPHYR_ACTIVE_VERSION="$VER"
            echo -e "Activated ${CYAN}Zephyr v$VER${NC} with ${CYAN}SDK v$sdkver${NC}."
            ;;
    esac
}

